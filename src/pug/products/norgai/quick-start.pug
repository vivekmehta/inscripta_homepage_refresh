        // Core theme CSS (includes Bootstrap)
        link(href='/css/styles.min.css', rel='stylesheet')

        style.
          .qs-lead { font-size: 1.05rem; }
          .qs-intro-list li { margin-bottom: .4rem; }
          .qs-step { margin-top: 3rem; }
          .qs-step-head { display: flex; align-items: center; margin-bottom: 1rem; }
          .qs-num { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: #192B80; color: #fff; font-weight: 700; font-size: 1.1rem; }
          .qs-step-head h2 { margin: 0 0 0 1rem; }
          .qs-fig { margin: 1.5rem 0; }
          .qs-shot { width: 100%; max-width: 760px; height: auto; display: block; border-radius: 12px; border: 1px solid #eaecf3; box-shadow: 0 12px 30px rgba(25, 43, 128, .12); }
          .qs-cap { margin-top: .6rem; font-size: .9rem; color: #6c757d; font-style: italic; max-width: 760px; }
          .qs-note { border-left: 4px solid #192B80; background: #f5f7ff; padding: .85rem 1.1rem; border-radius: 0 8px 8px 0; margin: 1.25rem 0; }
          .qs-note p { margin: 0; }
          .qs-table { max-width: 820px; }
          .qs-table th { background: #f5f7ff; }
          .qs-cta { margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid #eaecf3; }
          @media (max-width: 575px) { .qs-num { width: 38px; height: 38px; font-size: 1rem; } .qs-step-head h2 { font-size: 1.4rem; } }

